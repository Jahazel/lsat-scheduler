# Local values only. Never keep real-site credentials in local files.
# Loopback means this computer only. Use an empty local database with test data.
# Start the local container with: docker compose up -d --wait postgres
# This public password is for the loopback container only.
DATABASE_URL=postgresql://postgres:local-only@127.0.0.1:5432/drillmap

SCREENSHOT_EXTRACTOR=fake

# Generate a separate local Auth.js secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Use a separate Google sign-in client for localhost only.
# Authorized origin: http://localhost:3000
# Authorized redirect: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

SCAN_SPEND_WARNING_PING_URL=
SCAN_LIMIT_REACHED_PING_URL=

RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=

# Vercel sends this as the Bearer token on the daily cleanup cron.
CRON_SECRET=
