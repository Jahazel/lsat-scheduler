# Local values only. Never keep real-site credentials in local files.
# Loopback means this computer only. Use an empty local database with test data.
MONGODB_URI=mongodb://127.0.0.1:27017/lsat-scheduler

# No Anthropic key for local work. Admins use Sample analytics snapshots.
# Screenshot upload shows a plain error without a key.

# Generate a separate local Auth.js secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Use a separate Google sign-in client for localhost only.
# Authorized origin: http://localhost:3000
# Authorized redirect: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
