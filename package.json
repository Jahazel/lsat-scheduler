{
  "name": "drillmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "db:migrate": "node --import tsx scripts/migrate-postgres.mts",
    "prepare": "git config core.hooksPath .githooks || true",
    "migrate:analytics-snapshots": "node scripts/migrate-analytics-snapshots.mjs",
    "migrate:weekly-schedules": "node scripts/migrate-weekly-schedules.mjs",
    "migrate:activity-check-ins": "node scripts/migrate-activity-check-ins.mjs",
    "verify:adaptive-schedule-rollout": "node scripts/verify-adaptive-schedule-rollout.mjs",
    "reset:dev-data": "node --env-file=.env.local scripts/reset-dev-data.mjs",
    "make-admin": "node scripts/make-admin.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@tanstack/react-form": "^1.33.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "mongoose": "^9.9.3",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
